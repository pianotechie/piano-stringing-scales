{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Piano stringing scale metadata v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "make", "model", "kind", "coverage", "keyRange", "source", "contributors", "license"],
  "properties": {
    "schemaVersion": {"const": 1},
    "id": {"type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"},
    "make": {"type": "string", "minLength": 1, "maxLength": 200},
    "model": {"type": "string", "minLength": 1, "maxLength": 200},
    "variant": {"type": "string", "maxLength": 500},
    "yearFrom": {"type": ["integer", "null"], "minimum": 1600, "maximum": 9999},
    "yearTo": {"type": ["integer", "null"], "minimum": 1600, "maximum": 9999},
    "kind": {"enum": ["measured-original", "published-reference", "proposed-redesign"]},
    "coverage": {"enum": ["bass", "plain-wire", "partial", "full-keyboard"]},
    "keyRange": {
      "type": "object", "additionalProperties": false, "required": ["lowest", "highest"],
      "properties": {
        "lowest": {"type": "integer", "minimum": 21, "maximum": 108},
        "highest": {"type": "integer", "minimum": 21, "maximum": 108}
      }
    },
    "source": {"type": "string", "minLength": 1, "maxLength": 4000},
    "sourceURL": {"type": "string", "format": "uri", "pattern": "^https?://", "maxLength": 2000},
    "contributors": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": {"type": "string", "minLength": 1, "maxLength": 200}
    },
    "notes": {"type": "string", "maxLength": 10000},
    "license": {"const": "CC-BY-4.0"}
  }
}
